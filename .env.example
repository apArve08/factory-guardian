# Copy to .env and fill in. .env is git-ignored.

# --- Gemini (Google AI Studio key) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key
# Optional: override the model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# --- Grafana ---
GRAFANA_URL=https://your-stack.grafana.net
# Service account token (glsa_...) with Admin role.
# Admin is needed to provision the alert rule; Viewer is enough at query time.
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...

# --- Grafana Cloud OTLP gateway (from the OTLP integration page) ---
# HEADERS must be  Authorization=Basic%20<base64(instanceID:token)>  -- note %20, not a space.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Local ---
SIMULATOR_URL=http://localhost:8000
# Optional: a Grafana "public dashboard" URL (Share -> Public dashboard) so the
# console can embed it. Without this the console shows an "Open in Grafana" link.
# QUOTE it — the & in the query string breaks `source .env` otherwise.
# GRAFANA_EMBED_URL="https://your-stack.grafana.net/public-dashboards/<token>"
# MAX_TOOL_CHARS=3500          # trim tool results to fit the Gemini free tier
# LLM_MIN_GAP_SECONDS=4        # pace model calls
